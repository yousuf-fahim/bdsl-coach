# Raw and personal image data is never committed (CLAUDE.md rule).
data/raw/*
!data/raw/.gitkeep
data/own/*
!data/own/.gitkeep
# Large regenerable intermediates
data/processed/*.npz
data/processed/cache/
# Small processed files (splits.csv, labels.json) ARE committed for reproducibility.

.venv/
node_modules/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
.env
web/dist/
.vercel/
logs/

# Web: wasm runtimes are copied from node_modules at build time (scripts/copy-assets.mjs)
web/public/mediapipe-wasm/
web/public/ort/
# Parity fixture images are derived from the dataset (never committed)
web/tests/fixtures/images/
